{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Namaz",
  "version": "1.2.1",
  "identifier": "com.personal.namaz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "engine",
        "title": "Namaz",
        "url": "index.html?w=engine",
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": false,
        "width": 100,
        "height": 100,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "MIT licence. The adhan recording is CC BY 3.0, see the README.",
    "category": "Lifestyle",
    "shortDescription": "Prayer times and the adhan",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    }
  }
}
