{
  "name": "namaz-windows",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "Namaz for Windows: prayer times and the adhan, in the system tray.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dump-ui": "node scripts/dump-ui.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "check-version": "node scripts/sync-version.mjs --check",
    "tauri": "tauri",
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@types/node": "^26.6.4",
    "preact": "^10"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2",
    "@tauri-apps/cli": "^2",
    "playwright": "^1",
    "typescript": "^5.8",
    "vite": "^6",
    "vitest": "^3"
  }
}
